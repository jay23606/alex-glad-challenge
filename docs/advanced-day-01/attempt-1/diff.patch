+// --- Токены: оценка бюджета диалога ---
+
+// POST /api/tokens/estimate — оценка токенов диалога (эвристика bytes/4,
+// TokenEstimator в core; LLM не вызывается). role — enum из core Role;
+// content БЕЗ trim(): оценка считает реальные байты, обрезка исказила бы
+// результат. budget опционален: нет → remaining/fits бессмысленны
+// (budget/remaining = null, fits = true).
+export const tokenEstimateSchema = z.object({
+  messages: z
+    .array(
+      z.object({
+        role: z.enum(['system', 'user', 'assistant']),
+        content: z.string().max(8000, 'Слишком длинное сообщение — максимум 8000 символов'),
+      }),
+    )
+    .max(200, 'Слишком много сообщений — максимум 200'),
+  budget: z
+    .number()
+    .int('budget должен быть целым числом')
+    .min(0, 'budget не может быть отрицательным')
+    .max(10_000_000, 'budget слишком большой')
+    .optional(),
+});
+export type TokenEstimateInput = z.infer<typeof tokenEstimateSchema>;
