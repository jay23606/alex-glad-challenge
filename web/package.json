{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Локальный Next.js (день 28): dashboard + витрина поверх challenge/core. Только 127.0.0.1.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "postbuild": "node -e \"const fs=require('fs'); if (fs.existsSync('.next/standalone')) fs.cpSync('.next/static', '.next/standalone/web/.next/static', {recursive: true})\"",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "start:test": "next start -H 127.0.0.1 -p 3100",
    "dev:test": "next dev -H 127.0.0.1 -p 3100"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "next-themes": "^0.4.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "8.2.2",
    "vitest": "^5.0.0",
    "zod": "^3.24.1"
  }
}
